# Copy to .env.local and replace only the placeholder values.
# Never commit .env.local or a real service key.

APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173

# Local default. Docker Compose overrides this with PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./backend/data/housing.db
DB_AUTO_CREATE=true

# 공공데이터포털에서 발급받은 일반 인증키(Decoding)를 입력하세요.
DATA_GO_KR_SERVICE_KEY=replace_with_your_decoded_service_key
APPLYHOME_API_BASE_URL=https://api.odcloud.kr/api
LH_API_BASE_URL=https://apis.data.go.kr/B552555

# Optional: POST /api/v1/admin/collections 를 사용할 때 필요한 값.
# 비워두면 관리 API는 비활성화되고 CLI 수집만 허용됩니다.
ADMIN_API_TOKEN=replace_with_a_long_random_value

# PDF 원문은 로컬 파일시스템에 저장합니다. 이후 StoragePort의 S3 어댑터로 교체할 수 있습니다.
DOCUMENT_STORAGE_PATH=./backend/data/documents
PDF_DOWNLOAD_ENABLED=true
PDF_MAX_BYTES=52428800

# Collection policy
COLLECTION_LOOKBACK_DAYS=30
COLLECTION_FUTURE_DAYS=90
COLLECTION_PAGE_SIZE=100
COLLECTION_HTTP_TIMEOUT_SECONDS=20
COLLECTION_MAX_RETRIES=3
